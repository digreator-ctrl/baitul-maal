# ============================================
# BAITUL MAAL — ENVIRONMENT VARIABLES TEMPLATE
# ============================================

# Database Connection (Neon PostgreSQL)
# Contoh format Neon:
# DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth / Auth.js Secret
# Buat string random dengan command: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Production URL (saat di Vercel)
# NEXTAUTH_URL="https://baitul-maal.vercel.app"
